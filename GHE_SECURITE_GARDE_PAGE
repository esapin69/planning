/*
  GHE_SECURITE_GARDE_PAGE.js

  Version stable :
  - ne redemande pas la connexion si une session locale 90 jours existe
  - ne vérifie pas Apps Script à chaque chargement
  - protège les pages sensibles
  - conserve l'agent connecté pour préremplir le mail
*/

(function(){
  const CLE_SESSION_GHE = "ghe_session_site_token";
  const CLE_SESSION_EXPIRATION_GHE = "ghe_session_site_expiration";
  const CLE_AGENT_GHE = "ghe_agent_connecte";
  const PAGE_ACCUEIL = "./index.html";
  const DUREE_SESSION_MS_GHE = 90 * 24 * 60 * 60 * 1000;

  document.documentElement.style.visibility = "hidden";

  function ecrireCookieSession(token){
    if(!token) return;

    const secure = window.location.protocol === "https:" ? "; Secure" : "";
    document.cookie =
      CLE_SESSION_GHE + "=" + encodeURIComponent(token) +
      "; path=/" +
      "; max-age=" + Math.floor(DUREE_SESSION_MS_GHE / 1000) +
      "; SameSite=Lax" +
      secure;
  }

  function lireCookieSession(){
    const morceaux = document.cookie ? document.cookie.split(";") : [];

    for(const morceau of morceaux){
      const parts = morceau.trim().split("=");
      const nom = parts.shift();

      if(nom === CLE_SESSION_GHE){
        return decodeURIComponent(parts.join("=") || "");
      }
    }

    return "";
  }

  function sessionLocaleValide(){
    const maintenant = Date.now();

    try{
      const token = localStorage.getItem(CLE_SESSION_GHE) || "";
      const expiration = Number(localStorage.getItem(CLE_SESSION_EXPIRATION_GHE) || "0");

      if(token && expiration && expiration > maintenant){
        return token;
      }

      const tokenCookie = lireCookieSession();

      if(tokenCookie){
        localStorage.setItem(CLE_SESSION_GHE, tokenCookie);
        localStorage.setItem(CLE_SESSION_EXPIRATION_GHE, String(maintenant + DUREE_SESSION_MS_GHE));
        return tokenCookie;
      }

    }catch(e){}

    return "";
  }

  function pageActuelle(){
    return window.location.pathname + window.location.search + window.location.hash;
  }

  function retourConnexion(){
    window.location.replace(PAGE_ACCUEIL + "?connexion=1&retour=" + encodeURIComponent(pageActuelle()));
  }

  function afficherPage(){
    document.documentElement.style.visibility = "visible";
  }

  function lireAgent(){
    try{
      return JSON.parse(localStorage.getItem(CLE_AGENT_GHE) || "{}");
    }catch(e){
      return {};
    }
  }

  function remplirEmailAgent(){
    const agent = lireAgent();

    if(!agent || !agent.mail){
      return;
    }

    const champs = Array.from(document.querySelectorAll("input"));

    const champMailPrincipal =
      champs.find(input => String(input.type || "").toLowerCase() === "email" && !input.value) ||
      champs.find(input => String(input.placeholder || "").toLowerCase().includes("ton.email") && !input.value) ||
      champs.find(input => String(input.placeholder || "").toLowerCase().includes("exemple.fr") && !input.value) ||
      champs.find(input => String(input.name || "").toLowerCase().includes("mail") && !input.value) ||
      champs.find(input => String(input.id || "").toLowerCase().includes("mail") && !input.value);

    if(champMailPrincipal){
      champMailPrincipal.value = agent.mail;
      champMailPrincipal.dispatchEvent(new Event("input", { bubbles:true }));
      champMailPrincipal.dispatchEvent(new Event("change", { bubbles:true }));
    }
  }

  function verifier(){
    const token = sessionLocaleValide();

    if(!token){
      retourConnexion();
      return;
    }

    ecrireCookieSession(token);
    remplirEmailAgent();
    afficherPage();

    setTimeout(remplirEmailAgent, 300);
    setTimeout(remplirEmailAgent, 1000);
  }

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded", verifier);
  }else{
    verifier();
  }
})();
