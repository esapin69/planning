/*
  GHE_SECURITE_GARDE_PAGE.js

  A mettre sur les pages sensibles.
  Ligne a ajouter juste avant </body> :
  <script src="./GHE_SECURITE_GARDE_PAGE.js"></script>

  Role :
  - bloque l'acces direct si pas connecte
  - verifie la session avec Apps Script
  - garde la connexion 90 jours avec localStorage + cookie
  - memorise l'agent connecte
  - remplit automatiquement le premier champ mail vide de la page
*/

(function(){
  const PASSERELLE_SECURITE = "https://script.google.com/macros/s/AKfycbx7gnNRAlt6N2l8ODBJ4ycu-gNIELKpoQMNukDLoHOuTrImCv82TcLy3QjVeY30wnwz/exec";
  const CLE_SESSION_GHE = "ghe_session_site_token";
  const CLE_AGENT_GHE = "ghe_agent_connecte";
  const PAGE_ACCUEIL = "./index.html";
  const DUREE_SESSION_GHE = 90 * 24 * 60 * 60;

  document.documentElement.style.visibility = "hidden";

  function ecrireCookieSession(token){
    if(!token) return;

    const secure = window.location.protocol === "https:" ? "; Secure" : "";
    document.cookie =
      CLE_SESSION_GHE + "=" + encodeURIComponent(token) +
      "; path=/" +
      "; max-age=" + DUREE_SESSION_GHE +
      "; SameSite=Lax" +
      secure;
  }

  function lireCookieSession(){
    const morceaux = document.cookie ? document.cookie.split(";") : [];

    for(const morceau of morceaux){
      const parts = morceau.trim().split("=");
      const nom = parts.shift();

      if(nom === CLE_SESSION_GHE){
        return decodeURIComponent(parts.join("=") || "");
      }
    }

    return "";
  }

  function effacerCookieSession(){
    document.cookie = CLE_SESSION_GHE + "=; path=/; max-age=0; SameSite=Lax";
  }

  function pageActuelle(){
    return window.location.pathname + window.location.search + window.location.hash;
  }

  function retourConnexion(){
    try{
      localStorage.removeItem(CLE_SESSION_GHE);
      localStorage.removeItem(CLE_AGENT_GHE);
      effacerCookieSession();
    }catch(e){}

    window.location.replace(PAGE_ACCUEIL + "?connexion=1&retour=" + encodeURIComponent(pageActuelle()));
  }

  function afficherPage(){
    document.documentElement.style.visibility = "visible";
  }

  function stockerAgent(reponse){
    if(!reponse) return;

    const agent = {
      nom: reponse.nom || "",
      prenom: reponse.prenom || "",
      mail: reponse.mail || ""
    };

    try{
      localStorage.setItem(CLE_AGENT_GHE, JSON.stringify(agent));
    }catch(e){}
  }

  function lireAgent(){
    try{
      return JSON.parse(localStorage.getItem(CLE_AGENT_GHE) || "{}");
    }catch(e){
      return {};
    }
  }

  function remplirEmailAgent(){
    const agent = lireAgent();

    if(!agent || !agent.mail){
      return;
    }

    const champs = Array.from(document.querySelectorAll("input"));

    const champMailPrincipal =
      champs.find(input => String(input.type || "").toLowerCase() === "email" && !input.value) ||
      champs.find(input => String(input.placeholder || "").toLowerCase().includes("ton.email") && !input.value) ||
      champs.find(input => String(input.placeholder || "").toLowerCase().includes("exemple.fr") && !input.value) ||
      champs.find(input => String(input.name || "").toLowerCase().includes("mail") && !input.value) ||
      champs.find(input => String(input.id || "").toLowerCase().includes("mail") && !input.value);

    if(champMailPrincipal){
      champMailPrincipal.value = agent.mail;
      champMailPrincipal.dispatchEvent(new Event("input", { bubbles:true }));
      champMailPrincipal.dispatchEvent(new Event("change", { bubbles:true }));
    }
  }

  function appelerSecurite(action, params){
    return new Promise((resolve, reject) => {
      const callbackName = "callbackGardePage_" + Date.now() + "_" + Math.random().toString(36).slice(2);
      const script = document.createElement("script");

      const data = Object.assign({}, params || {}, {
        action: action,
        callback: callbackName,
        t: Date.now()
      });

      const timeout = setTimeout(() => {
        nettoyer();
        reject(new Error("Temps d attente depasse."));
      }, 12000);

      function nettoyer(){
        clearTimeout(timeout);

        if(script.parentNode){
          script.parentNode.removeChild(script);
        }

        try{
          delete window[callbackName];
        }catch(e){
          window[callbackName] = undefined;
        }
      }

      window[callbackName] = function(reponse){
        nettoyer();
        resolve(reponse);
      };

      script.onerror = function(){
        nettoyer();
        reject(new Error("Securite inaccessible."));
      };

      script.src = PASSERELLE_SECURITE + "?" + new URLSearchParams(data).toString();
      document.body.appendChild(script);
    });
  }

  async function verifier(){
    let token = "";

    try{
      token = localStorage.getItem(CLE_SESSION_GHE) || lireCookieSession() || "";
    }catch(e){
      retourConnexion();
      return;
    }

    if(!token){
      retourConnexion();
      return;
    }

    try{
      const reponse = await appelerSecurite("verifier_session", { token: token });

      if(reponse && reponse.ok && reponse.connecte){
        localStorage.setItem(CLE_SESSION_GHE, token);
        ecrireCookieSession(token);
        stockerAgent(reponse);
        remplirEmailAgent();
        afficherPage();

        setTimeout(remplirEmailAgent, 300);
        setTimeout(remplirEmailAgent, 1000);
        return;
      }

      retourConnexion();

    }catch(err){
      retourConnexion();
    }
  }

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded", verifier);
  }else{
    verifier();
  }
})();
